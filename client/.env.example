# LifeWell frontend — copy to .env.local and fill in.
# Only NEXT_PUBLIC_* values are exposed to the browser; keep secrets out.
#
# These are read at BUILD time and baked into the output. Changing them in
# Vercel requires a redeploy, not just a restart.

# Base URL of the Node API (server/).
NEXT_PUBLIC_API_URL=https://lifewellfhp-server.vercel.app

# Canonical site origin. Drives metadata, canonicals, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://lifewellfhp-client.vercel.app

# Local development (optional):
# NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID. Leave blank to disable analytics.
# The production property carried over from the WordPress site is G-31C1GHVRGF.
NEXT_PUBLIC_GA4_ID=
