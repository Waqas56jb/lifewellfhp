# LifeWell API — copy to .env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=4000

# Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- contact ---
# Where contact-form notifications are delivered.
CONTACT_EMAIL=contact@lifewellfhp.com
MAIL_FROM="LifeWell Website <no-reply@lifewellfhp.com>"

# SMTP. Leave blank in development to run in log-only mode (nothing is sent).
# In production the server refuses to start a submission without these.
#
# IMPORTANT: the contact form can receive protected health information.
# Use a provider that will sign a Business Associate Agreement (for example
# Paubox, Hushmail Healthcare, or Google Workspace with a BAA in place).
# Standard transactional providers do not offer a BAA on default plans.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ------------------------------------------------------------- newsletter ---
# none | mailchimp | convertkit
# Leave as "none" until a provider is chosen; the server will log rather than
# pretend a subscription succeeded.
NEWSLETTER_PROVIDER=none
NEWSLETTER_API_KEY=
# Mailchimp audience ID, or ConvertKit form ID.
NEWSLETTER_LIST_ID=

# ------------------------------------------------------------ rate limits ---
# Requests per IP per hour.
RATE_LIMIT_CONTACT=5
RATE_LIMIT_NEWSLETTER=3
